generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model Student {
  id                String   @id @default(cuid())
  name              String
  email             String?  @unique
  passwordHash      String?
  educationLevel    String   @default("SCHOOL")
  preferredLanguage String   @default("EN")
  teacherAvatar     String   @default("MALE")
  voiceRate         Float    @default(1.0)
  lastLoginAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  preferredMode     String   @default("GUIDED")
  currentDifficulty String   @default("MEDIUM")
  preferredSubject  String   @default("MATH")
  voicePreset       String?  @default("FRIENDLY")

  sessions            AttemptSession[]
  confidenceChecks    ConfidenceCheck[]
  reflections         Reflection[]
  achievements        Achievement[]
  independentScore    IndependentScore?
  hintEvents          HintEvent[]
  authSessions        AuthSession[]
  subjects            StudentSubject[]
  conversations       Conversation[]
  mistakeRecords      MistakeRecord[]
  knowledgeRecords    KnowledgeRecord[]
  confidenceRecords   ConfidenceRecord[]
  explainBacks        ExplainBack[]
  nextBestActions     NextBestAction[]
  challenges          Challenge[]
  missions            Mission[]
  vivas               VivaSession[]
  exams               Exam[]
  notes               NoteDocument[]
  explainAnswers      ExplainAnswer[]
  messageFeedbacks    MessageFeedback[]
  teacherMemories     TeacherMemory[]
  studyRoadmaps       StudyRoadmap[]
  miniLessons         MiniLesson[]
  studyStreak         StudyStreak?
}

model AuthSession {
  id        String   @id @default(cuid())
  token     String   @unique
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([studentId])
}

model Problem {
  id         String   @id @default(cuid())
  slug       String   @unique
  subject    String
  topic      String
  difficulty String
  title      String
  content    String
  solution   String
  stepsJson  String?
  createdAt  DateTime @default(now())

  sessions AttemptSession[]
}

model AttemptSession {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  problemId        String
  problem          Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  mode             String   @default("INDEPENDENT")
  isAiFree         Boolean  @default(false)
  startedAt        DateTime @default(now())
  finishedAt       DateTime?
  status           String   @default("ACTIVE")
  currentHintLevel Int      @default(0)
  finalResult      String   @default("NONE")
  watchOutJson     String?

  attempts         Attempt[]
  hintEvents       HintEvent[]
  confidenceChecks ConfidenceCheck[]
  reflections      Reflection[]
  explainAnswers   ExplainAnswer[]

  @@index([studentId, status])
}

model Attempt {
  id            String   @id @default(cuid())
  sessionId     String
  session       AttemptSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attemptNumber Int
  answer        String
  isCorrect     Boolean  @default(false)
  hintLevelUsed Int      @default(0)
  timeTakenSec  Int?
  mistakeType   String   @default("NONE")
  reasoning     String   @default("ADEQUATE")
  aiFeedback    String
  createdAt     DateTime @default(now())

  @@unique([sessionId, attemptNumber])
}

model HintEvent {
  id          String   @id @default(cuid())
  sessionId   String
  session     AttemptSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  level       Int
  content     String
  requestedAt DateTime @default(now())

  @@index([studentId])
}

model ConfidenceCheck {
  id          String   @id @default(cuid())
  sessionId   String
  session     AttemptSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptId   String?
  confidence  Int
  actualCorrect Boolean @default(false)
  createdAt   DateTime @default(now())

  @@index([studentId])
}

model Reflection {
  id        String   @id @default(cuid())
  sessionId String
  session   AttemptSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  createdAt DateTime @default(now())
}

model Achievement {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  key         String
  title       String
  description String
  unlockedAt  DateTime @default(now())

  @@unique([studentId, key])
}

model IndependentScore {
  id                   String   @id @default(cuid())
  studentId            String   @unique
  student              Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  totalProblems        Int      @default(0)
  solvedWithoutFull    Int      @default(0)
  firstAttemptCorrect  Int      @default(0)
  totalAttempts        Int      @default(0)
  totalHints           Int      @default(0)
  aiFreeAttempts       Int      @default(0)
  aiFreeSuccess        Int      @default(0)
  retrySuccesses       Int      @default(0)
  retryOpportunities   Int      @default(0)
  lastWeekAvgHints     Float    @default(0)
  thisWeekAvgHints     Float    @default(0)
  updatedAt            DateTime @updatedAt

  @@index([studentId])
}

model SubjectCatalog {
  id         String   @id @default(cuid())
  key        String   @unique
  name       String
  category   String
  level      String   @default("SCHOOL")
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  topics      Topic[]
  enrollments StudentSubject[]
  profiles    TeacherProfile[]

  @@index([category, isActive])
}

model Topic {
  id        String @id @default(cuid())
  subjectId String
  subject   SubjectCatalog @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  slug      String

  @@unique([subjectId, slug])
}

model TeacherProfile {
  id                 String @id @default(cuid())
  subjectId          String? @unique
  subject            SubjectCatalog? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  category           String? @unique
  style              String
  focusJson          String
  commonMistakesJson String
  examplesJson       String
  rulesJson          String
  createdAt          DateTime @default(now())
}

model StudentSubject {
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   SubjectCatalog @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([studentId, subjectId])
  @@index([subjectId])
}

model Conversation {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind            String   @default("TEXT")
  mode            String   @default("GUIDED")
  pedagogicalMode String?
  isAiFree        Boolean  @default(false)
  language        String   @default("EN")
  subjectKey      String?
  topic           String?
  title           String?
  status          String   @default("ACTIVE")
  lastMessageAt   DateTime @default(now())
  messageCount    Int      @default(0)
  createdAt       DateTime @default(now())

  messages     Message[]
  explainBacks ExplainBack[]

  @@index([studentId, status])
  @@index([studentId, kind])
  @@index([studentId, lastMessageAt])
}

model Message {
  id                 String   @id @default(cuid())
  conversationId     String
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role               String
  content            String
  language           String?
  source             String
  hintLevel          Int      @default(0)
  wasFullExplanation Boolean  @default(false)
  tokensIn           Int?
  tokensOut          Int?
  metaJson           String?
  createdAt          DateTime @default(now())

  feedback           MessageFeedback?

  @@index([conversationId, createdAt])
}

model MistakeRecord {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectKey     String?
  topic          String?
  mistakeType    String
  description    String
  why            String?
  status         String   @default("OPEN")
  source         String
  sessionId      String?
  conversationId String?
  occurrences    Int      @default(1)
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([studentId, status])
  @@index([studentId, mistakeType])
}

model KnowledgeRecord {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectKey    String
  topic         String
  masteryPct    Float    @default(0)
  evidenceCount Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([studentId, subjectKey, topic])
  @@index([studentId])
}

model ConfidenceRecord {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectKey    String?
  topic         String?
  confidencePct Float
  actualCorrect Boolean?
  context       String?
  createdAt     DateTime @default(now())

  @@index([studentId, subjectKey, topic])
}

model ExplainBack {
  id                 String   @id @default(cuid())
  studentId          String
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  conversationId     String?
  conversation       Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  subjectKey         String?
  topic              String
  explanation        String
  analysisJson       String
  understandingScore Float    @default(0)
  accuracyPct        Float    @default(0)
  completenessPct    Float    @default(0)
  reasoningPct       Float    @default(0)
  createdAt          DateTime @default(now())

  @@index([studentId, createdAt])
}

model NextBestAction {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String
  why         String
  estMinutes  Int
  subjectKey  String?
  topic       String?
  actionType  String
  targetRef   String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@index([studentId, status])
}

model Challenge {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectKey      String?
  topic           String?
  difficulty      String   @default("MEDIUM")
  problemText     String
  solution        String
  studentSolution String?
  analysisJson    String?
  score           Float?
  confidencePct   Float?
  status          String   @default("PENDING")
  isDaily         Boolean  @default(false)
  dayKey          String?
  createdAt       DateTime @default(now())

  @@index([studentId, status])
  @@index([studentId, dayKey])
}

model Mission {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic           String
  title           String
  description     String
  weaknessKey     String
  sourceMistakeId String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  steps MissionStep[]

  @@index([studentId, status])
  @@index([studentId, weaknessKey])
}

model MissionStep {
  id            String   @id @default(cuid())
  missionId     String
  mission       Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  order         Int
  kind          String
  content       String
  answer        String?
  status        String   @default("PENDING")
  studentAnswer String?
  analysisJson  String?
  score         Float?
  attempts      Int      @default(0)
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  @@unique([missionId, order])
}

model VivaSession {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectKey    String?
  topic         String
  difficulty    String   @default("MEDIUM")
  language      String   @default("EN")
  status        String   @default("ACTIVE")
  questionCount Int      @default(5)
  totalScore    Float?
  summaryJson   String?
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  questions VivaQuestion[]

  @@index([studentId, status])
}

model VivaQuestion {
  id            String   @id @default(cuid())
  vivaId        String
  viva          VivaSession @relation(fields: [vivaId], references: [id], onDelete: Cascade)
  order         Int
  question      String
  concept       String?
  studentAnswer String?
  isCorrect     Boolean?
  understanding Float?
  feedback      String?
  score         Float?
  createdAt     DateTime @default(now())

  @@unique([vivaId, order])
}

model Exam {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title         String
  subjectKey    String?
  topic         String?
  difficulty    String   @default("MEDIUM")
  timeLimitSec  Int?
  questionCount Int
  status        String   @default("ACTIVE")
  score         Float?
  summaryJson   String?
  sourceNoteId  String?
  note          NoteDocument? @relation(fields: [sourceNoteId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  submittedAt   DateTime?

  questions ExamQuestion[]

  @@index([studentId, status])
}

model ExamQuestion {
  id            String   @id @default(cuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  order         Int
  type          String
  question      String
  optionsJson   String?
  answer        String
  studentAnswer String?
  isCorrect     Boolean?
  analysis      String?
  points        Float    @default(1)

  @@unique([examId, order])
}

model NoteDocument {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title          String
  sourceType     String
  charCount      Int
  summary        String?
  keyPointsJson  String?
  flashcardsJson String?
  createdAt      DateTime @default(now())

  chunks NoteChunk[]
  exams  Exam[]

  @@index([studentId])
}

model NoteChunk {
  id      String @id @default(cuid())
  docId   String
  doc     NoteDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
  idx     Int
  content String

  @@unique([docId, idx])
}

model ExplainAnswer {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId        String
  session          AttemptSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attemptId        String?
  answerWasCorrect Boolean
  explanation      String
  reasoningCorrect Boolean
  reasoningScore   Float
  feedback         String
  createdAt        DateTime @default(now())

  @@index([studentId, createdAt])
}

model MessageFeedback {
  id         String   @id @default(cuid())
  messageId  String   @unique
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rating     String
  category   String?
  comment    String?
  createdAt  DateTime @default(now())

  @@index([studentId, createdAt])
}

model TeacherMemory {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category   String
  topic      String?
  content    String
  confidence Float    @default(0.5)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([studentId, category])
  @@index([studentId, topic])
}

model StudyRoadmap {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  subjectKey  String?
  roadmapJson String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  @@index([studentId, status])
}

model MiniLesson {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic         String
  subjectKey    String?
  sectionsJson  String
  currentStep   Int      @default(0)
  status        String   @default("ACTIVE")
  scorePct      Float    @default(0)
  createdAt     DateTime @default(now())

  @@index([studentId, status])
}

model StudyStreak {
  id             String    @id @default(cuid())
  studentId      String    @unique
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?
  updatedAt      DateTime  @updatedAt
}
