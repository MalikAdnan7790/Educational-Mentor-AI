# Database — PostgreSQL for Vercel deployment
# Get your connection string from Vercel Dashboard → Storage → Create Postgres database
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# For local development with SQLite, use:
# DATABASE_URL="file:./dev.db"

# OpenAI — required for the real AI mentor (speech, chat, evaluation).
# Without it the app still runs using the built-in rule-based engine.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini
# Fallback models — tried in order when primary is overloaded/rate-limited
# For Gemini free-tier, add multiple models to avoid hitting daily quotas
OPENAI_MODEL_FALLBACKS=gemini-2.0-flash,gemini-2.5-flash-preview-04-17

NEXT_PUBLIC_APP_NAME="Educational Mentor AI"
